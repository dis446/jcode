/target
Cargo.lock
__pycache__/
ios_simulator_screenshot.png
/.wrangler/
/tmp/
# Local onboarding sandbox + auth fixtures. May contain REAL OAuth tokens copied
# from $HOME (see scripts/onboarding_sandbox.sh seed-real-logins). Never commit.
/.tmp/
# jcode writes per-session runtime state into a checkout's .jcode (logs,
# active pids, telemetry, generated images). Everything there is machine-local
# except repo-owned content, which stays explicitly trackable below.
/.jcode/*
!/.jcode/skills/
!/.jcode/tools.json
!/.jcode/commands.json
!/.jcode/prompts/
!/.jcode/semantic-todo-migration-spec.md
/telemetry-worker/backups/
target-ttest/
target-ttest*/

# Local capture artefacts are not committed baselines.
captures/

# Stray experiment/debug artifacts at the repo root. Real assets live under
# assets/, docs/, ios/, and tests/ and are committed explicitly.
/*.log
/*.avif
/*.mp4
/*.png
