From 4e0935b46bc87371448175e90200870cc013f6af Mon Sep 17 00:00:00 2001
From: Tsetsen-erdene Ganbaatar <dis446@yahoo.com>
Date: Thu, 29 Oct 2026 14:12:37 +0800
Subject: [PATCH] test(config): cover the provider_balance chip toggle

Defaults on, absent key stays on, explicit false disables.
---
 crates/jcode-config-types/src/display.rs | 12 ++++++++++++
 1 file changed, 12 insertions(+)

diff --git a/crates/jcode-config-types/src/display.rs b/crates/jcode-config-types/src/display.rs
index 0b8f1c17f..0032a8a6d 100644
--- a/crates/jcode-config-types/src/display.rs
+++ b/crates/jcode-config-types/src/display.rs
@@ -255,4 +255,16 @@ mod tests {
             serde_json::from_str(r#"{"usage_display":"used"}"#).expect("display config");
         assert!(used.usage_display_used());
     }
+
+    #[test]
+    fn provider_balance_chip_defaults_on_and_accepts_opt_out() {
+        assert!(DisplayConfig::default().provider_balance);
+
+        let missing: DisplayConfig = serde_json::from_str("{}").expect("display config");
+        assert!(missing.provider_balance);
+
+        let disabled: DisplayConfig =
+            serde_json::from_str(r#"{"provider_balance":false}"#).expect("display config");
+        assert!(!disabled.provider_balance);
+    }
 }
