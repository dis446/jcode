+/// CUSTOM (fork ledger C1): render snapshot of the `@file` popup.
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub struct AtFileView {
+    /// (name, display path, is_dir)
+    pub rows: Vec<(String, String, bool)>,
+    pub selected: usize,
+}
