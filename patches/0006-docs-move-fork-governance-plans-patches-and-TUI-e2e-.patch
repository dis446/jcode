+index abadfdee8..edadb6dbf 100644
+--- a/crates/jcode-tui/src/tui/app/input.rs
++++ b/crates/jcode-tui/src/tui/app/input.rs
+@@ -967,6 +967,12 @@ fn insert_input_text_with_undo(app: &mut App, text: &str, typed: bool) {
+ 
+     app.reset_tab_completion();
+     app.sync_model_picker_preview_from_input();
++    // CUSTOM (C1): typing drives the @file popup, paste cancels it.
++    if typed {
++        app.at_file_after_edit();
++    } else {
++        app.at_file_close();
++    }
+ }
+ 
