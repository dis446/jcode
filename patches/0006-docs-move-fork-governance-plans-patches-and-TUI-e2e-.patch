+# jcode TUI e2e regression suite
+
+Deterministic, fast, binary-only. It drives a real `jcode` binary in a private tmux
+server and asserts on the rendered screen. It needs no source tree and no cargo,
+so the **same suite runs against stock upstream and against our fork build**.
+
+```bash
+e2e/run.py --binary "$(command -v jcode)" --suite baseline       # stock: must be green
+e2e/run.py --binary ~/Code/Personal/jcode/target/selfdev/jcode --suite all
+e2e/run.py --binary ... --suite baseline --repeat 8 -j 12         # flake hunt
+```
+
+| Suite | Runs on | Meaning |
+| ----- | ------- | ------- |
+| `baseline` | stock **and** fork | Behavior the fork must never change (composer, slash palette, paste, resize, undo). |
+| `at_file` | fork only (C1) | The `@file` picker. Fails on stock by design: proves the tests detect the feature. |
+
+## Why it is deterministic
+
+- Each test gets its own `HOME`, `JCODE_HOME`, `JCODE_RUNTIME_DIR`, `XDG_RUNTIME_DIR`,
+  tmux server socket and work tree. Scrubbed env (`env -i`), telemetry and updates off.
+  Tests therefore run in parallel safely and never touch `~/.jcode` or your daemon.
+- No network, no provider: only the composer is exercised, nothing is sent.
+- No fixed sleeps. Every step polls the screen for a predicate with a hard timeout and
+  prints the last screen on failure.
+- Teardown kills the tmux server and any jcode server that inherited the sandbox
+  runtime dir, then removes the sandbox.
+- Verified: 80/80 on `--repeat 8 -j 12` against stock 0.99.1 (6.7 s), no leaked processes.
+
+## Rules
+
+1. Every custom change (ledger row in ../FORK.md) ships with tests in a suite here.
+2. A fork change that breaks `baseline` is a regression, full stop.
+3. On every upstream upgrade: run `baseline` on the **new stock** binary first (catches
+   upstream UI changes that invalidate our assertions), then on the rebased fork.
+4. When a test breaks because upstream changed legitimately, fix the assertion in the same
+   commit as the upgrade and say so in the ledger.
+
+## Not covered (and why)
+
+Model/tool turns, streaming, swarm, reload handoff. Those need a provider. Upstream's
+`tests/e2e` (mock provider, run with `cargo test --test e2e`) covers them from source and
+should be run after each upgrade in the fork checkout. The slow Rust `jcode-tui` lib suite
+is not a gate: see `../FORK.md` "Test gates".
diff --git a/e2e/harness.py b/e2e/harness.py
new file mode 100644
index 000000000..3ba763533
--- /dev/null
+++ b/e2e/harness.py
@@ -0,0 +1,157 @@
+"""Deterministic TUI harness for jcode, driven through tmux.
+
+Works against ANY jcode binary (stock upstream or our fork build): it only uses
+the public CLI and the rendered screen. No cargo, no source tree.
+
+Determinism rules:
+  * Fully isolated: temp JCODE_HOME, JCODE_RUNTIME_DIR, HOME, XDG_RUNTIME_DIR,
+    private tmux server socket, scrubbed environment, telemetry and update off.
+  * No network and no provider needed: the composer is exercised before any
+    request is sent.
+  * No fixed sleeps. Every step polls the screen until a predicate holds or a
+    hard timeout fails the test with the last screen attached.
+"""
+from __future__ import annotations
+
+import os
+import shutil
+import subprocess
+import tempfile
+import time
+import uuid
+
+DEFAULT_TIMEOUT = 15.0
+
+
+class Timeout(AssertionError):
+    pass
+
+
+class Session:
+    def __init__(self, binary: str, files: list[str] | None = None,
+                 cols: int = 120, rows: int = 32, args: list[str] | None = None):
+        self.binary = binary
+        self.root = tempfile.mkdtemp(prefix="jcode-e2e-")
+        self.work = os.path.join(self.root, "work")
+        self.home = os.path.join(self.root, "home")
+        self.run = os.path.join(self.root, "run")
+        for d in (self.work, self.home, self.run):
+            os.makedirs(d)
+        os.chmod(self.run, 0o700)
+        for f in files or []:
+            path = os.path.join(self.work, f)
+            os.makedirs(os.path.dirname(path), exist_ok=True)
+            if f.endswith("/"):
+                continue
+            open(path, "w").close()
+        self.tmux_sock = os.path.join(self.root, "tmux.sock")
+        self.name = "e2e" + uuid.uuid4().hex[:8]
+        env = {
+            "HOME": self.home,
+            "PATH": os.environ.get("PATH", "/usr/bin:/bin"),
+            "TERM": "xterm-256color",
+            "LANG": "C.UTF-8",
+            "JCODE_HOME": os.path.join(self.home, ".jcode"),
+            "JCODE_RUNTIME_DIR": self.run,
+            "XDG_RUNTIME_DIR": self.run,
+            "JCODE_NO_TELEMETRY": "1",
+        }
+        envargs = " ".join(f"{k}={shlex_quote(v)}" for k, v in env.items())
+        cmd = f"env -i {envargs} {shlex_quote(binary)} --no-update --no-selfdev " + " ".join(args or [])
+        self._tmux("new-session", "-d", "-s", self.name, "-x", str(cols), "-y", str(rows),
+                   "-c", self.work, cmd)
+
+    # -- plumbing ---------------------------------------------------------
+    def _tmux(self, *a: str) -> str:
+        r = subprocess.run(["tmux", "-S", self.tmux_sock, *a], capture_output=True, text=True)
+        if r.returncode != 0:
+            raise RuntimeError(f"tmux {a}: {r.stderr.strip()}")
+        return r.stdout
+
+    def screen(self) -> str:
+        try:
+            out = self._tmux("capture-pane", "-p", "-t", self.name)
+        except RuntimeError:
+            return ""
+        return "\n".join(line.rstrip() for line in out.splitlines())
+
+    def alive(self) -> bool:
+        r = subprocess.run(["tmux", "-S", self.tmux_sock, "has-session", "-t", self.name],
+                           capture_output=True)
+        return r.returncode == 0
+
+    # -- input ------------------------------------------------------------
+    def type(self, text: str) -> None:
+        self._tmux("send-keys", "-t", self.name, "-l", text)
+
+    def key(self, *keys: str) -> None:
+        self._tmux("send-keys", "-t", self.name, *keys)
+
+    def paste(self, text: str) -> None:
+        buf = "b" + uuid.uuid4().hex[:6]
+        self._tmux("set-buffer", "-b", buf, text)
+        self._tmux("paste-buffer", "-p", "-b", buf, "-t", self.name)
+
+    # -- waiting ----------------------------------------------------------
+    def wait_for(self, pred, what: str, timeout: float = DEFAULT_TIMEOUT) -> str:
+        deadline = time.monotonic() + timeout
+        last = ""
+        while time.monotonic() < deadline:
+            last = self.screen()
+            if pred(last):
+                return last
+            time.sleep(0.05)
+        raise Timeout(f"timed out waiting for: {what}\n--- last screen ---\n{last}\n---")
+
+    def wait_text(self, needle: str, timeout: float = DEFAULT_TIMEOUT) -> str:
+        return self.wait_for(lambda s: needle in s, f"text {needle!r}", timeout)
+
+    def wait_gone(self, needle: str, timeout: float = DEFAULT_TIMEOUT) -> str:
+        return self.wait_for(lambda s: needle not in s, f"{needle!r} to disappear", timeout)
+
+    def settle(self, quiet: float = 0.4, timeout: float = DEFAULT_TIMEOUT) -> str:
+        """Return once the screen stops changing for `quiet` seconds."""
+        deadline = time.monotonic() + timeout
+        prev, since = None, time.monotonic()
+        while time.monotonic() < deadline:
+            cur = self.screen()
+            if cur != prev:
+                prev, since = cur, time.monotonic()
+            elif time.monotonic() - since >= quiet:
+                return cur
+            time.sleep(0.05)
+        raise Timeout("screen never settled\n" + (prev or ""))
+
+    def wait_ready(self) -> str:
+        """First stable frame with a composer on screen."""
+        self.wait_for(lambda s: s.strip() != "", "any output", 30)
+        return self.settle(quiet=0.6, timeout=30)
+
+    def _kill_leftovers(self) -> None:
+        """Kill any process (e.g. the auto-spawned jcode server) that inherited our runtime dir."""
+        marker = f"JCODE_RUNTIME_DIR={self.run}".encode()
+        for pid in os.listdir("/proc"):
+            if not pid.isdigit() or int(pid) == os.getpid():
+                continue
+            try:
+                with open(f"/proc/{pid}/environ", "rb") as fh:
+                    if marker in fh.read().split(b"\0"):
+                        os.kill(int(pid), 9)
+            except (OSError, ProcessLookupError):
+                pass
+
+    def close(self) -> None:
+        subprocess.run(["tmux", "-S", self.tmux_sock, "kill-server"], capture_output=True)
+        self._kill_leftovers()
+        shutil.rmtree(self.root, ignore_errors=True)
+
+    def __enter__(self):
+        return self
+
+    def __exit__(self, *exc):
+        self.close()
+
+
+def shlex_quote(s: str) -> str:
+    import shlex
+    return shlex.quote(s)
diff --git a/e2e/run.py b/e2e/run.py
new file mode 100755
index 000000000..fb1da01f0
--- /dev/null
+++ b/e2e/run.py
@@ -0,0 +1,84 @@
+#!/usr/bin/env python3
+"""Run the jcode TUI e2e suites against any binary, in parallel, deterministically.
+
+  run.py --binary $(which jcode) --suite baseline
+  run.py --binary ~/Code/Personal/jcode/target/selfdev/jcode --suite all
+
+Each test owns a fully isolated sandbox (see harness.py), so tests run in
+parallel safely. Exit 0 only if every selected test passes. Artifacts (the last
+screen of every failure) go to --artifacts.
+"""
+import argparse
+import concurrent.futures as cf
+import importlib
+import os
+import subprocess
+import sys
+import time
+import traceback
+
+sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
+
+SUITES = {"baseline": "suite_baseline", "at_file": "suite_at_file"}
+
+
+def version_of(binary):
+    out = subprocess.run([binary, "--version"], capture_output=True, text=True).stdout
+    # "jcode v0.99.1 (7206efd0c)"
+    for tok in out.split():
+        if tok.startswith("v") and tok[1:2].isdigit():
+            return tok[1:]
+    return None
+
+
+def run_one(binary, version, modname, name, timeout):
+    mod = importlib.import_module(modname)
+    fn = getattr(mod, name)
+    start = time.monotonic()
+    try:
+        fn(binary, version)
+        return modname, name, True, time.monotonic() - start, ""
+    except BaseException:
+        return modname, name, False, time.monotonic() - start, traceback.format_exc()
+
+
+def main():
+    ap = argparse.ArgumentParser()
+    ap.add_argument("--binary", required=True)
+    ap.add_argument("--suite", default="baseline", choices=[*SUITES, "all"])
+    ap.add_argument("-k", default="", help="substring filter on test name")
+    ap.add_argument("-j", type=int, default=6)
+    ap.add_argument("--repeat", type=int, default=1, help="run N times, fail on any flake")
+    ap.add_argument("--artifacts", default=os.path.expanduser("~/tmp/jcode-e2e-artifacts"))
+    a = ap.parse_args()
+
+    binary = os.path.realpath(os.path.expanduser(a.binary))
+    version = version_of(binary)
+    print(f"binary: {binary}\nversion: {version}")
+    names = list(SUITES.values()) if a.suite == "all" else [SUITES[a.suite]]
+    jobs = []
+    for modname in names:
+        mod = importlib.import_module(modname)
+        for n in sorted(dir(mod)):
+            if n.startswith("t_") and a.k in n:
+                jobs += [(modname, n)] * a.repeat
+
+    os.makedirs(a.artifacts, exist_ok=True)
+    t0 = time.monotonic()
+    failed = []
+    with cf.ThreadPoolExecutor(max_workers=a.j) as ex:
+        futs = [ex.submit(run_one, binary, version, m, n, 60) for m, n in jobs]
+        for f in cf.as_completed(futs):
+            m, n, ok, dt, tb = f.result()
+            print(f"{'PASS' if ok else 'FAIL'}  {m}.{n}  {dt:4.1f}s")
+            if not ok:
+                failed.append((m, n))
+                with open(os.path.join(a.artifacts, f"{m}.{n}.txt"), "a") as fh:
+                    fh.write(tb + "\n")
+                print("   " + tb.strip().splitlines()[-1][:200])
+    print(f"\n{len(jobs) - len(failed)}/{len(jobs)} passed in {time.monotonic() - t0:.1f}s")
+    sys.exit(1 if failed else 0)
+
+
+if __name__ == "__main__":
+    main()
